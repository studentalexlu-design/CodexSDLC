{
    "gate-id": "gate-a",
    "display-name": "系統分析確認",
    "current-boundary": "scan -> domain/analyst",
    "next-stage-if-approved": "domain",
    "documents-to-review": [
        {
            "id": "project-profile",
            "name": "project profile",
            "path": "bdd-docs/artifacts/project-profile.md",
            "required": true
        },
        {
            "id": "impact-report",
            "name": "impact report",
            "path": "bdd-docs/runs/{run-id}/artifacts/impact-report.md",
            "required": "unless-greenfield"
        },
        {
            "id": "lean-sdlc-checklist-system-analysis",
            "name": "lean SDLC checklist 系統分析 rows",
            "path": "bdd-docs/runs/{run-id}/artifacts/lean-sdlc-checklist.md",
            "required": true
        },
        {
            "id": "runtime-db-policy-summary",
            "name": "runtime / DB policy summary",
            "path": "bdd-docs/runs/{run-id}/artifacts/runtime-db-policy.md",
            "required": false
        },
        {
            "id": "legacy-sql-extraction",
            "name": "legacy SQL 邏輯萃取（重構情境）",
            "path": "bdd-docs/runs/{run-id}/artifacts/legacy-sql-analysis/{feature-id}.md",
            "required": "unless-not-applicable"
        }
    ],
    "user-verification-checklist": [
        "專案邊界是否正確",
        "介接與資料需求是否合理",
        "impact report 的 editable / forbidden / risky areas 是否可接受",
        "DB schema 來源策略是否符合已批准狀態",
        "legacy SQL 內嵌業務邏輯是否已萃取並區分 data-access / business-rule（重構情境）",
        "是否同意進入 domain / analyst"
    ],
    "decision-options": [
        "approve-gate",
        "return-for-fix",
        "pause-workflow",
        "free-text"
    ],
    "decision-log-requirements": [
        "gate-id",
        "reviewed-document-refs",
        "verification-checklist",
        "user-decision",
        "next-stage-if-approved"
    ]
}