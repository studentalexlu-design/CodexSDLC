{
    "gate-id": "gate-b",
    "display-name": "Domain 確認",
    "current-boundary": "domain -> analyst/formulation",
    "next-stage-if-approved": "discovery-phase0",
    "documents-to-review": [
        {
            "id": "domain-glossary",
            "name": "domain glossary",
            "path": "bdd-docs/runs/{run-id}/artifacts/domain-glossary.md",
            "required": true
        },
        {
            "id": "source-conflicts",
            "name": "source conflicts",
            "path": "bdd-docs/runs/{run-id}/artifacts/source-conflicts.md",
            "required": true
        },
        {
            "id": "domain-reviewer-evidence",
            "name": "domain reviewer evidence",
            "path": "bdd-docs/runs/{run-id}/artifacts/reviews/",
            "required": true
        },
        {
            "id": "domain-context-pack",
            "name": "domain context pack",
            "path": "bdd-docs/runs/{run-id}/artifacts/context-packs/domain.md",
            "required": true
        },
        {
            "id": "legacy-sql-extraction-dispositions",
            "name": "legacy SQL 規則處置決策（重構情境）",
            "path": "bdd-docs/runs/{run-id}/artifacts/legacy-sql-analysis/{feature-id}.md",
            "required": "unless-not-applicable"
        }
    ],
    "user-verification-checklist": [
        "domain terms 是否正確",
        "source conflicts 是否已解決或有明確決策",
        "domain context pack 是否忠實反映已核准 domain",
        "每條 legacy SQL 內嵌業務規則的處置（keep-in-sql / move-to-domain / move-to-application / redesign / drop / defer）是否確認（重構情境）",
        "下游 analyst / formulation 是否可採信此 domain context",
        "是否同意進入 analyst"
    ],
    "decision-options": [
        "approve-gate",
        "return-for-fix",
        "pause-workflow",
        "free-text"
    ],
    "decision-log-requirements": [
        "gate-id",
        "reviewed-document-refs",
        "verification-checklist",
        "user-decision",
        "next-stage-if-approved"
    ]
}