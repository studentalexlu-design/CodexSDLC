{
    "gate-id": "gate-close",
    "applies-to-tiers": ["t0", "t1", "t2"],
    "display-name": "交付確認",
    "subsumes": "舊模型的 intake + Gate-A + Gate-D + Gate-E 在低／中不可逆層級的角色",
    "current-boundary": "verify -> close",
    "next-stage-if-approved": "completed",
    "requires": [
        "source-materials-register.status != pending",
        "acceptance-criteria.exists",
        "tests.failed == 0 AND tests.skipped == 0",
        "safe-change-envelope.confirmed",
        "revertible-in-single-commit OR tier != t0",
        "lean-sdlc.checklist.rows satisfied-or-not-applicable"
    ],
    "tier-conditional-requires": {
        "t0": [
            "one-line-dod.stated",
            "behaviour-equivalent.confirmed",
            "no-spawn-used (subagent-calls.count == 0)"
        ],
        "t1": [
            "feature-spec.exists (Gherkin)",
            "spec-reviewer.verdict == PASS (mode: gherkin)",
            "acceptance-tests.executable"
        ],
        "t2": [
            "gate-contract.approved (在實作之前)",
            "contract-tests.passed",
            "code-reviewer.verdict == PASS (mode: tdd)",
            "integration-evidence.passed OR not-applicable"
        ]
    },
    "documents-to-review": [
        {
            "id": "acceptance-criteria",
            "name": "驗收依據（t0 = 一行 DoD；t1/t2 = Gherkin feature）",
            "path": "bdd-docs/runs/{run-id}/artifacts/features/",
            "required": true
        },
        {
            "id": "safe-change-envelope",
            "name": "safe-change envelope（editable-paths / forbidden / 風險評估）",
            "path": "bdd-docs/runs/{run-id}/artifacts/impact-report.md",
            "required": true
        },
        {
            "id": "test-evidence",
            "name": "測試證據（command、exit code、total/passed/failed/skipped、trx path）",
            "path": "bdd-docs/runs/{run-id}/artifacts/evidence/",
            "required": true
        },
        {
            "id": "review-evidence",
            "name": "審核證據（t1 = spec-reviewer；t2 = spec-reviewer + code-reviewer）",
            "path": "bdd-docs/runs/{run-id}/artifacts/reviews/",
            "required": "unless-tier-t0"
        },
        {
            "id": "lean-sdlc-checklist",
            "name": "lean SDLC checklist rows",
            "path": "bdd-docs/runs/{run-id}/artifacts/lean-sdlc-checklist.md",
            "required": true
        }
    ],
    "user-verification-checklist": [
        "驗收依據是否符合原始意圖，且可作為驗收基準",
        "實際改動是否落在 safe-change envelope 內 —— **核准本 Gate 即等於核准此 envelope**",
        "改動是否未跨越本 tier 的不可逆性邊界（t0：仍可單一 commit revert 且行為等價；t1：未動對外契約；t2：未動既有資料或在跑的流量）",
        "測試是否 failed == 0 且 skipped == 0",
        "**t0/t1 不跑 code-reviewer —— production code 品質由本確認把關**：請檢視 diff 範圍、測試覆蓋與 minimal-implementation 是否合理（無未經批准的新相依、新抽象層或無關重構）",
        "V-manual 情境：人工驗收 checklist 與截圖證據是否齊全",
        "V-prod 情境：分階段上線或 feature flag 是否已就位",
        "checklist 標為 not-applicable 的項目是否都帶有 `tier-t{n}` reason",
        "是否同意結案（completed）"
    ],
    "escalate-instead-of-approve-when": [
        "t0：diff 已無法單一 commit revert、或出現需驗收的行為變更 → 升 t1",
        "t1：發現對外契約會被我控制不了的消費者看到差異 → 升 t2",
        "t2：發現會動到既有資料、在跑的流量或認證授權 → 升 t3",
        "任何 tier：實際改動大幅逾越 safe-change envelope",
        "任何 tier：已用滿 max-subagent-calls 仍未達成綠燈",
        "任何 tier：過程中發現現況或可行性不明 → **停止交付，改開 probe／spike run**，不是升 tier"
    ],
    "decision-options": [
        "approve-gate",
        "return-for-fix",
        "escalate-tier",
        "open-probe-run",
        "pause-workflow",
        "free-text"
    ],
    "decision-log-requirements": [
        "gate-id",
        "tier",
        "reviewed-document-refs",
        "verification-checklist",
        "safe-change-envelope-summary",
        "user-decision",
        "next-stage-if-approved"
    ]
}
