{
    "gate-id": "gate-d",
    "display-name": "開發準備與證據確認",
    "current-boundary": "formulation/ATDD -> TDD",
    "next-stage-if-approved": "tdd",
    "documents-to-review": [
        {
            "id": "feature-spec-gherkin-final",
            "name": "feature spec / Gherkin final",
            "path": "bdd-docs/runs/{run-id}/artifacts/features/",
            "required": true
        },
        {
            "id": "acceptance-tests",
            "name": "acceptance tests",
            "path": "bdd-docs/runs/{run-id}/artifacts/acceptance-tests/",
            "required": true
        },
        {
            "id": "atdd-skeleton-step-definitions",
            "name": "ATDD skeleton and step definitions",
            "path": "bdd-docs/runs/{run-id}/artifacts/atdd/",
            "required": true
        },
        {
            "id": "safe-change-envelope",
            "name": "safe-change envelope",
            "path": "bdd-docs/runs/{run-id}/artifacts/impact-report.md",
            "required": true
        },
        {
            "id": "lean-sdlc-checklist-program-development",
            "name": "lean SDLC checklist 程式開發 rows",
            "path": "bdd-docs/runs/{run-id}/artifacts/lean-sdlc-checklist.md",
            "required": true
        },
        {
            "id": "design-drafts",
            "name": "設計 draft（API contract / ER model / sequence / module）",
            "path": "bdd-docs/runs/{run-id}/artifacts/design/",
            "required": "unless-design-not-applicable"
        }
    ],
    "user-verification-checklist": [
        "Gherkin final 是否代表核准需求",
        "設計 draft（API/ER/sequence/module）是否與 Gherkin 及 domain 一致，或已標記 N/A",
        "acceptance tests 是否可執行",
        "safe-change envelope 是否可接受",
        "進入 TDD production code 變更是否已明確批准",
        "完成後 production code / unit tests / build-test / code review evidence rows 是否需要再次確認"
    ],
    "decision-options": [
        "approve-gate",
        "return-for-fix",
        "pause-workflow",
        "free-text"
    ],
    "decision-log-requirements": [
        "gate-id",
        "reviewed-document-refs",
        "verification-checklist",
        "user-decision",
        "next-stage-if-approved"
    ]
}