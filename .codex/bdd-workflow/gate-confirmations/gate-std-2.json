{
    "gate-id": "gate-std-2",
    "profile": "standard",
    "display-name": "實作就緒與交付確認",
    "merges": [
        "gate-d",
        "gate-e"
    ],
    "current-boundary": "integration-done -> living-doc",
    "next-stage-if-approved": "living-doc",
    "requires": [
        "feature-spec.reviewed",
        "acceptance-tests.executable",
        "safe-change-envelope.confirmed",
        "contract-tests.passed OR contract.not-applicable",
        "integration-tests.passed OR integration.not-applicable",
        "smoke-test.user-approved-and-passed OR smoke.not-applicable",
        "lean-sdlc.stage.program-development.required-artifacts satisfied-or-not-applicable"
    ],
    "pre-gate-invariant": {
        "note": "本 Gate 位於 integration 之後，但 `safe-change-envelope.confirmed` 是**進入 TDD 前**就必須取得的獨立使用者批准（orchestrator 不變原則 5，所有層級適用）。本 Gate 只**查核該批准的紀錄是否存在且實際改動未逾越 envelope**，不是補批准的地方。若進入 TDD 前未取得批准，視為流程違規：停止推進、記錄 decision-log 並回報使用者。",
        "verified-approval-ref": "bdd-docs/runs/{run-id}/decision-log.md"
    },
    "documents-to-review": [
        {
            "id": "feature-spec-gherkin-final",
            "name": "feature spec / Gherkin final",
            "path": "bdd-docs/runs/{run-id}/artifacts/features/",
            "required": true
        },
        {
            "id": "spec-reviewer-gherkin-evidence",
            "name": "spec-reviewer（mode: gherkin）審核證據（standard 唯一一次 reviewer）",
            "path": "bdd-docs/runs/{run-id}/artifacts/reviews/",
            "required": true
        },
        {
            "id": "acceptance-tests",
            "name": "acceptance tests",
            "path": "bdd-docs/runs/{run-id}/artifacts/acceptance-tests/",
            "required": true
        },
        {
            "id": "atdd-skeleton-step-definitions",
            "name": "ATDD skeleton and step definitions",
            "path": "bdd-docs/runs/{run-id}/artifacts/atdd/",
            "required": true
        },
        {
            "id": "safe-change-envelope",
            "name": "safe-change envelope 與其進入 TDD 前的批准紀錄",
            "path": "bdd-docs/runs/{run-id}/artifacts/impact-report.md",
            "required": true
        },
        {
            "id": "integration-evidence",
            "name": "contract / integration / smoke 測試證據（standard 由 integration-tester `mode: all` 單次產出）",
            "path": "bdd-docs/runs/{run-id}/artifacts/integration/",
            "required": "unless-not-applicable"
        },
        {
            "id": "lean-sdlc-checklist-development-and-verification",
            "name": "lean SDLC checklist 程式開發與整合驗證 rows",
            "path": "bdd-docs/runs/{run-id}/artifacts/lean-sdlc-checklist.md",
            "required": true
        }
    ],
    "user-verification-checklist": [
        "Gherkin final 是否代表核准需求，spec-reviewer 缺陷是否已收斂",
        "acceptance tests 是否可執行且 failed == 0、pending == 0",
        "safe-change envelope 是否在進入 TDD 前已取得批准，且實際改動未逾越 envelope",
        "**standard 在 TDD 後不跑 code-reviewer —— production code 品質由本確認把關**：請檢視 diff 範圍、測試覆蓋與 minimal-implementation 是否合理（無未經批准的新相依、新抽象層或無關重構）",
        "API 回應是否符合契約（狀態碼 / schema / 錯誤結構），或已標記 N/A",
        "整合流程是否通過且無阻塞缺陷，或已標記 N/A",
        "smoke test 是否已批准執行且通過，或已標記 N/A",
        "測試環境是否可重建、無明顯 flaky 風險",
        "checklist 標為 not-applicable 的項目是否都帶有 `profile-standard` reason",
        "是否同意進入 living-doc 收尾"
    ],
    "escalate-instead-of-approve-when": [
        "review 或驗證揭露需要 DB schema 變更、破壞性公開契約變更或遺留 SQL 萃取",
        "實際改動大幅逾越 safe-change envelope",
        "已用滿 10 次 spawn 仍未達成綠燈"
    ],
    "decision-options": [
        "approve-gate",
        "return-for-fix",
        "escalate-to-full",
        "pause-workflow",
        "free-text"
    ],
    "decision-log-requirements": [
        "gate-id",
        "reviewed-document-refs",
        "verification-checklist",
        "safe-change-approval-ref",
        "user-decision",
        "next-stage-if-approved"
    ]
}
