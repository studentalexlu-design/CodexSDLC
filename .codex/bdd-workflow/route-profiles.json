  "handoff-field": "tier",
  "default-when-unconfirmed": "standard",
  "escalation-only": true,
  "enforced-by": ".codex/scripts/handoff-lint.ps1",
  "call-count-tracked-in": "bdd-docs/runs/{run-id}/workflow-state.json subagent-calls.count",
  "call-count-note": "orchestrator 每次 spawn 後必須遞增，比照 quality-loop.iteration。handoff-lint 讀此欄位與本區塊的 max-subagent-calls 機械阻斷超額 spawn；不遞增等同讓上限失效。",
  "profiles": {
