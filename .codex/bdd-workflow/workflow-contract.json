{
  "contract-version": "1.13.0",
  "min-compatible-version": "1.0.0",
  "released": "2026-07-29",
  "stages": [
    "init",
    "intake",
    "intake-done",
    "complexity-assessment",
    "scan",
    "scan-done",
    "domain",
    "domain-done",
    "domain-confirmed",
    "discovery-phase0",
    "discovery-phase1",
    "discovery-done",
    "data-model-p1",
    "formulate",
    "formulate-done",
    "design",
    "design-done",
    "data-model-p2-5",
    "atdd",
    "atdd-done",
    "tdd",
    "tdd-done",
    "integration",
    "integration-done",
    "living-doc",
    "verified",
    "completed"
  ],
  "gates-ref": {
    "note": "Extracted for lean loading (v1.12.0). Each gate's `requires`, `merges`, documents-to-review and verification checklist now live in that gate's own confirmation file. Read ONLY the single gate file for the gate being confirmed — never the whole set. Which gates are active is decided by `route-profiles.profiles.{profile}.gates`.",
    "dir": ".codex/bdd-workflow/gate-confirmations/",
    "requires-key": "requires",
    "gate-ids": [
      "intake",
      "gate-a",
      "gate-b",
      "gate-c",
      "gate-d",
      "gate-e",
      "gate-lite",
      "gate-std-1",
      "gate-std-2"
    ]
  },
  "repo-index": {
    "note": "確定性索引。機械性探索（定位檔案、列相依、比對 SQL 樣式、抓簽章）一律由腳本完成，LLM 只讀索引與訊號清單。程序見 runbook-ref。",
    "runbook-ref": ".codex/bdd-workflow/runbooks/repo-indexing.md",
    "index-path": "bdd-docs/artifacts/repo-index/index.json",
    "digest-path": "bdd-docs/artifacts/repo-index/index-digest.json",
    "sql-signals-path": "bdd-docs/artifacts/repo-index/sql-signals.json",
    "legacy-schema-dir": "bdd-docs/artifacts/legacy-schema/",
    "scope": "global-cross-run",
    "scripts": {
      "index": ".codex/scripts/repo-index.ps1",
      "sql-scan": ".codex/scripts/sql-scan.ps1",
      "impact-scope": ".codex/scripts/impact-scope.ps1"
    },
    "invalidation": {
      "mode": "git-first-hash-fallback",
      "scopes": [
        "structure",
        "config",
        "symbols"
      ],
      "partial-refresh": true,
      "status-command": "repo-index.ps1 -StatusOnly"
    },
    "max-index-read-tokens": 6000,
    "impact-default-top-n": 12,
    "unavailable-behavior": "fall-back-to-bounded-llm-scan-and-mark environment:index-unavailable"
  },
  "route-profiles-ref": {
    "note": "Extracted for lean loading (v1.12.0). This is the startup routing slice — bdd-orchestrator reads the referenced file at complexity-assessment instead of this whole contract. On resume it reads neither: runtime-metadata.profile already holds the answer. handoff-lint.ps1 reads max-subagent-calls from the same file.",
    "path": ".codex/bdd-workflow/route-profiles.json",
    "handoff-field": "tier",
    "profile-stored-in": "bdd-docs/runs/{run-id}/workflow-state.json runtime-metadata.profile",
    "call-count-tracked-in": "bdd-docs/runs/{run-id}/workflow-state.json subagent-calls.count",
    "context-reset-tracked-in": "bdd-docs/runs/{run-id}/workflow-state.json subagent-calls.count-at-last-reset",
    "context-reset-note": "Gate 核准時可選擇在新對話續跑（gate 檔的 decision-options 含 approve-and-resume-in-new-conversation 時提供）。count − count-at-last-reset >= 4 時該選項排第一並標為建議。orchestrator 讀進的檔案會在之後每一輪重送，Gate 是唯一零資訊損失的歸零點。",
    "enforced-by": ".codex/scripts/handoff-lint.ps1",
    "profile-names": [ "lite", "standard", "full" ]
  },
  "lean-sdlc-ref": {
    "note": "Extracted for lean loading (v1.10.0). Read only when checking lean-SDLC checklist requirements for a specific stage boundary.",
    "path": ".codex/bdd-workflow/lean-sdlc-schema.json"
  },
  "minimal-implementation-policy-ref": {
    "note": "Extracted for lean loading (v1.12.0). The ladder, prohibited list, and required-preservation list live ONLY in the policy file — they were duplicated here verbatim, which is the drift risk this contract otherwise forbids. Pass the path; do not inline the content.",
    "mode": "local-guardrail",
    "policy-path": ".codex/bdd-workflow/policies/minimal-implementation-policy.md",
    "applies-to-agents": [
      "tdd-implementer",
      "code-reviewer (mode: tdd)",
      "project-scanner"
    ],
    "does-not-override": [
      "gates",
      "lean-sdlc checklist",
      "DLP and secret-safety rules",
      "safe-change approvals",
      "required tests and evidence",
      "validation",
      "error handling",
      "security",
      "accessibility"
    ]
  },
  "db-introspection-ref": {
    "note": "Extracted for lean loading (v1.12.0). Only `full` runs that chose the DB-MCP schema-source strategy ever need this. Approval envelope fields, run-scoped SELECT authorization bounds, query-safety and forbidden lists live in the policy file — read it at that point, not at startup.",
    "mode": "approved-read-only-mcp",
    "policy-path": ".codex/bdd-workflow/policies/db-mcp-introspection-policy.md",
    "live-db-access": "mcp-only",
    "sole-exit": "db-introspection-scanner",
    "requires-user-approval-before-spawn": true,
    "allowed-scopes": [
      "metadata",
      "definition",
      "approved-select"
    ],
    "unavailable-mcp-behavior": "return blocked and use manual schema/source alternatives"
  },
  "checkpoint-schema-version": "1.1.0",
  "artifact-schema-version": "1.0.0",
  "compiled-context": {
    "run-index": "bdd-docs/runs/{run-id}/index.md",
    "operation-log": "bdd-docs/runs/{run-id}/log.md",
    "context-packs": "bdd-docs/runs/{run-id}/artifacts/context-packs/{stage}.md",
    "lean-sdlc-checklist": "bdd-docs/runs/{run-id}/artifacts/lean-sdlc-checklist.md",
    "db-select-authorization": "bdd-docs/runs/{run-id}/artifacts/db-select-authorization.md",
    "gate-confirmation-template": ".codex/bdd-workflow/templates/gate-confirmation.md",
    "read-priority": [
      "workflow-state.json",
      "runtime-metadata",
      "index.md",
      "log.md recent-or-delta",
      "context-packs/{stage}.md path-plus-summary",
      "full-artifacts-on-demand"
    ],
    "context-budget": {
      "startup-max-input-tokens": 8000,
      "handoff-summary-max-chars": 500,
      "reviewer-summary-max-chars": 500,
      "subagent-handoff-max-chars": 1200,
      "subagent-single-operation": true,
      "subagent-network-error-retry-limit": 0,
      "subagent-compressed-retry-requires-user-confirmation": true,
      "subagent-max-wall-clock-minutes-before-pause": 8,
      "operation-log-read-mode": "recent-or-delta",
      "operation-log-recent-entry-limit": 20,
      "forbidden-prompt-payloads": [
        "full-operation-log",
        "full-source-materials-register",
        "all-context-packs",
        "long-test-output",
        "full-shared-artifact-unless-gate-or-review"
      ]
    },
    "context-pack-policy": {
      "handoff-mode": "path-plus-summary",
      "no-nested-upstream-fulltext": true,
      "allowed-content": [
        "decision-summary",
        "artifact-refs",
        "open-questions",
        "evidence-refs"
      ]
    },
    "quality-loop": {
      "max-iterations": 3,
      "absolute-max-iterations": 4,
      "escalation": "user-arbitration",
      "escalation-method": "Codex user confirmation",
      "reviewer-must-list-all-defects-per-pass": true,
      "iteration-tracked-in": "bdd-docs/runs/{run-id}/workflow-state.json quality-loop.iteration",
      "verdict-tracked-in": "bdd-docs/runs/{run-id}/workflow-state.json quality-loop.last-verdict",
      "enforced-by": ".codex/scripts/handoff-lint.ps1 (PreToolUse on subagent spawn)",
      "note": "落地到 workflow-state.json（原為 session-only 的 working-state）才能被 hook 機械驗證。orchestrator 每次 reviewer 回傳後必須更新這兩個欄位。"
    },
    "agent-runbook-policy": {
      "agent-mode-files-stay-slim": true,
      "read-runbook-only-for-active-mode": true,
      "runbook-dir": ".codex/bdd-workflow/runbooks"
    },
    "cache-stability": {
      "policy-path": ".codex/bdd-workflow/policies/cache-stability-policy.md",
      "artifact-versioning-policy-path": ".codex/bdd-workflow/policies/artifact-versioning-policy.md",
      "handoff-template-dir": ".codex/bdd-workflow/templates",
      "enforce-template-by-mode": true,
      "stable-prompt-structure": [
        "constraints",
        "output-contract",
        "meta",
        "target",
        "gate|review-focus|context",
        "summary"
      ],
      "stable-prompt-structure-note": "靜態在前、易變在後。`constraints` 與 `output-contract` 同 mode 完全固定，排前面才可能進入共用前綴；`meta`（run-id / feature-id / tier）每次都變，排最後。順序顛倒會讓靜態內容永遠無法快取。`.codex/bdd-workflow/templates/` 是此順序的 source of truth。",
      "atdd-partial-requires-checkpoint-before-retry": true,
      "avoid-frequent-full-agent-edit": true
    },
    "checkpoint-required-fields": [
      "checkpoint-id",
      "run-id",
      "timestamp",
      "stage",
      "next-step",
      "resume-hint",
      "pending-items",
      "open-questions",
      "blocker",
      "last-artifact-digest",
      "context-pack-versions",
      "lean-sdlc-checklist",
      "quality-loop"
    ],
    "domain-wiki": {
      "output": "bdd-docs/runs/{run-id}/artifacts/context-packs/domain.md",
      "trigger": "domain-user-confirmed",
      "requires": [
        "domain-glossary.status == approved",
        "source-conflicts.resolved",
        "user-confirmation.domain == approved"
      ]
    }
  },
  "operations": {
    "lint": {
      "owner": "living-doc",
      "checks": [
        "metadata",
        "link-integrity",
        "version-consistency",
        "gate-consistency",
        "stale-checkpoints",
        "secret-safety"
      ]
    },
    "compile-context-pack": {
      "owner": "living-doc",
      "output": "bdd-docs/runs/{run-id}/artifacts/context-packs/{stage}.md",
      "trigger": "major-stage-done"
    },
    "compile-domain-wiki": {
      "owner": "living-doc",
      "output": "bdd-docs/runs/{run-id}/artifacts/context-packs/domain.md",
      "trigger": "domain-user-confirmed"
    },
    "update-runtime-metadata": {
      "owner": "living-doc",
      "output": "bdd-docs/runs/{run-id}/workflow-state.json.runtime-metadata",
      "trigger": "checkpoint-or-stage-change"
    },
    "update-lean-sdlc-checklist": {
      "owner": "living-doc",
      "output": "bdd-docs/runs/{run-id}/artifacts/lean-sdlc-checklist.md",
      "trigger": "new-run-or-stage-boundary"
    }
  },
  "skill-loading-policy": {
    "mode": "lazy",
    "matrix-is-capability-index": true,
    "load-only-when-triggered": true,
    "cache-within-active-run": true
  },
  "return-contract": {
    "reviewer-verdict": "VERDICT: PASS|FAIL + BLOCKER/MAJOR/MINOR counts",
    "doer-status-enum": [
      "completed",
      "partial-completed",
      "db-introspection-needed",
      "phase0-iteration-completed",
      "blocked",
      "error"
    ]
  },
  "agent-skill-matrix-ref": {
    "note": "Extracted for lean loading (v1.10.0). Read only during skill-loading decisions or version-migration checks; per-agent skill lookups only need that agent's own entry.",
    "path": ".codex/bdd-workflow/agent-skill-matrix.json"
  },
  "migration-policy": {
    "auto-migrate": [
      "patch"
    ],
    "confirm-migrate": [
      "minor"
    ],
    "block-migrate": [
      "major"
    ]
  },
  "deprecation-policy": {
    "sunset-after-versions": 2
  }
}
