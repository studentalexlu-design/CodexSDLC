{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(?i)(subagent|spawn|send_input|^agent$|^task$)",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .codex/scripts/handoff-lint.ps1",
            "commandWindows": "$env:PSExecutionPolicyPreference='Bypass'; & ./.codex/scripts/handoff-lint.ps1; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Enforcing handoff contract before subagent spawn or send_input"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|^apply_patch$|^shell$|^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .codex/scripts/dlp-gate.ps1",
            "commandWindows": "$env:PSExecutionPolicyPreference='Bypass'; & ./.codex/scripts/dlp-gate.ps1; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "DLP residual scan on written artifacts"
          }
        ]
      },
      {
        "matcher": "Edit|Write|^apply_patch$|^shell$|^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .codex/scripts/guideline-gate.ps1",
            "commandWindows": "$env:PSExecutionPolicyPreference='Bypass'; & ./.codex/scripts/guideline-gate.ps1; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Project guideline scan on written files"
          }
        ]
      },
      {
        "matcher": "Edit|Write|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .codex/scripts/build-check.ps1",
            "commandWindows": "$env:PSExecutionPolicyPreference='Bypass'; & ./.codex/scripts/build-check.ps1; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Build check (production code changes only)"
          }
        ]
      }
    ]
  }
}
