{
  "note": "範例規則。整份請換成你們團隊自己的。severity 省略時預設 warn；block 會直接讓那次寫檔失敗，所以要明確寫。applies-to 省略 = 套用到所有未被排除的檔。改完跑 `pwsh -NoProfile -File .codex/scripts/guideline-gate.ps1 -Validate`。",
  "rules": [
    {
      "id": "sql-no-nolock",
      "applies-to": ["**/*.sql", "**/*.cs", "**/*.java"],
      "pattern": "(?i)\\bWITH\\s*\\(\\s*NOLOCK\\s*\\)",
      "severity": "block",
      "message": "禁止 NOLOCK —— 會讀到未提交的資料，也可能重複讀或漏讀同一列",
      "fix": "改用 READ COMMITTED SNAPSHOT；真的要接受髒讀就寫進 spec.md 並取得批准"
    },
    {
      "id": "sql-no-dynamic-exec",
      "applies-to": ["**/*.sql"],
      "pattern": "(?i)\\b(EXEC\\s*\\(|sp_executesql)\\b",
      "severity": "block",
      "message": "禁止動態組出來的 SQL —— 注入風險，而且靜態分析看不見它實際會跑什麼",
      "fix": "改成參數化查詢；分支條件搬到應用層"
    },
    {
      "id": "no-hardcoded-connstring",
      "applies-to": ["**/*.cs", "**/*.java"],
      "pattern": "(?i)(Server|Data\\s*Source)\\s*=[^;\"']{1,80};\\s*(Initial\\s*Catalog|Database)\\s*=",
      "severity": "block",
      "message": "程式碼裡不得寫死連線字串",
      "fix": "移到設定或 secret store，並確認這個值沒有進過版控歷史"
    },
    {
      "id": "sql-no-select-star",
      "applies-to": ["**/*.sql", "**/*.cs", "**/*.java"],
      "pattern": "(?i)\\bSELECT\\s+\\*",
      "severity": "warn",
      "message": "SELECT * 會讓「加一個欄位」變成靜默的行為改變",
      "fix": "把欄位列出來"
    },
    {
      "id": "sql-no-cursor",
      "applies-to": ["**/*.sql"],
      "pattern": "(?i)\\bDECLARE\\s+\\w+\\s+CURSOR\\b",
      "severity": "warn",
      "message": "cursor 逐列處理，量一大就是效能事故",
      "fix": "改成集合運算；真的需要逐列就搬到應用層"
    },
    {
      "id": "no-empty-catch",
      "applies-to": ["**/*.cs", "**/*.java"],
      "pattern": "catch\\s*\\([^)]*\\)\\s*\\{\\s*\\}",
      "severity": "warn",
      "message": "空的 catch 會把錯誤吞掉，事故現場什麼都不會留下（只抓得到寫在同一行的寫法）",
      "fix": "要嘛處理、要嘛往上拋並保留原始例外"
    },
    {
      "id": "no-ambient-clock",
      "applies-to": ["**/*.cs"],
      "pattern": "\\bDateTime\\.(Now|UtcNow)\\b",
      "severity": "warn",
      "message": "直接讀系統時間的邏輯測不動 —— 跟時間有關的分支永遠只測得到「現在」",
      "fix": "從邊界注入時間來源（IClock／TimeProvider）"
    },
    {
      "id": "api-no-verb-in-route",
      "applies-to": ["**/*Controller.cs", "**/*Resource.java"],
      "pattern": "(?i)\\[(?:Route|Http\\w+)\\s*\\(\\s*\"[^\"]*(?:^|/)(?:get|create|update|delete|cancel|save)[A-Za-z]*\"",
      "severity": "warn",
      "message": "路徑用資源名詞，動詞由 HTTP method 表達（見 guidelines/api.md 的 MUST 第一條）",
      "fix": "POST /orders/{id}/cancellations，不是 POST /orders/cancelOrder"
    }
  ]
}
