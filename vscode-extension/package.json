{
  "name": "codex-sdlc",
  "displayName": "Codex SDLC",
  "description": "Codex SDLC 工作流的駕駛艙：狀態列、設定面板、Problems、一鍵 doctor／apply／tune。它只是 sdlc.ps1 與各 gate 的殼，真相仍在 sdlc.config.json 與腳本裡。",
  "version": "4.10.0",
  "publisher": "codex-sdlc",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:.codex/bdd-workflow/bdd-workflow-version.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "這個 extension 會執行工作區裡的 .codex/scripts/*.ps1，受限模式下不啟動。"
    },
    "virtualWorkspaces": false
  },
  "codexSdlc": {
    "jsonSchema": 1
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSdlc",
          "title": "Codex SDLC",
          "icon": "media/codex-sdlc.svg"
        }
      ]
    },
    "views": {
      "codexSdlc": [
        {
          "id": "codexSdlc.settings",
          "name": "設定",
          "contextualTitle": "Codex SDLC"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexSdlc.settings",
        "when": "!codexSdlc.active",
        "contents": "這個資料夾還沒有 Codex SDLC 工作流（.codex/、.agents/、AGENTS.md）。\n\n安裝會先看發佈物來源有沒有新版，沒有就用這個 extension 內附的那一份。已經有的 AGENTS.md 與 guidelines/ 不會被覆蓋。\n[安裝到這個工作區](command:codexSdlc.install)\n[選擇發佈物…](command:codexSdlc.installFrom)\n[這是什麼](command:codexSdlc.openWalkthrough)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexSdlc.refresh",
          "when": "view == codexSdlc.settings && codexSdlc.active",
          "group": "navigation@1"
        },
        {
          "command": "codexSdlc.doctor",
          "when": "view == codexSdlc.settings && codexSdlc.active",
          "group": "navigation@2"
        },
        {
          "command": "codexSdlc.install",
          "when": "view == codexSdlc.settings && !codexSdlc.active",
          "group": "navigation@1"
        },
        {
          "command": "codexSdlc.openWalkthrough",
          "when": "view == codexSdlc.settings",
          "group": "overflow"
        },
        {
          "command": "codexSdlc.showOutput",
          "when": "view == codexSdlc.settings",
          "group": "overflow"
        }
      ],
      "view/item/context": [
        {
          "command": "codexSdlc.editSetting",
          "when": "view == codexSdlc.settings && viewItem == editable",
          "group": "inline"
        },
        {
          "command": "codexSdlc.apply",
          "when": "view == codexSdlc.settings && viewItem == tuningPending",
          "group": "inline"
        },
        {
          "command": "codexSdlc.repair",
          "when": "view == codexSdlc.settings && viewItem == toolFilesMissing",
          "group": "inline"
        },
        {
          "command": "codexSdlc.mergeAgents",
          "when": "view == codexSdlc.settings && viewItem == needsMerge",
          "group": "inline"
        },
        {
          "command": "codexSdlc.pickPwsh",
          "when": "view == codexSdlc.settings && viewItem == machinePwsh",
          "group": "inline"
        },
        {
          "command": "codexSdlc.toggleGate",
          "when": "view == codexSdlc.settings && viewItem =~ /^gate(On|Off)$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "codexSdlc.editSetting",
          "when": "false"
        },
        {
          "command": "codexSdlc.applyProposalFor",
          "when": "false"
        },
        {
          "command": "codexSdlc.openFile",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "codexSdlc.start",
        "title": "開始使用 Codex SDLC",
        "description": "四步：把工作流裝進這個資料夾、選一組調校、跑一次健檢、知道設定在哪裡改。",
        "steps": [
          {
            "id": "install",
            "title": "把工作流裝進這個資料夾",
            "description": "沒有 .codex/、.agents/、AGENTS.md 的資料夾，這套流程一條都不會跑。已經有的 AGENTS.md 與 guidelines/ 不會被覆蓋。\n[安裝到這個工作區](command:codexSdlc.install)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:codexSdlc.active"
            ]
          },
          {
            "id": "preset",
            "title": "選一組調校",
            "description": "fast／balanced／deep —— 先列出會改哪些值，確認才寫，寫完自動套用。之後隨時可以在設定面板個別改。\n[選預設組合](command:codexSdlc.applyPreset)",
            "media": {
              "markdown": "media/walkthrough/preset.md"
            },
            "completionEvents": [
              "onCommand:codexSdlc.applyPreset"
            ]
          },
          {
            "id": "doctor",
            "title": "跑一次健檢",
            "description": "doctor 會檢查版本、調校有沒有套用、規範檔、工具檔齊不齊。結果在輸出面板，狀態列左下角也會一直顯示。\n[跑 doctor](command:codexSdlc.doctor)",
            "media": {
              "markdown": "media/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onCommand:codexSdlc.doctor"
            ]
          },
          {
            "id": "settings",
            "title": "設定在哪裡改",
            "description": "活動列的 Codex SDLC 圖示 → 設定面板：一眼看到全部設定，點一下就能改，需要套用的會標出來。\n[開啟設定面板](command:codexSdlc.openSettings)",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            },
            "completionEvents": [
              "onView:codexSdlc.settings"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "codexSdlc.menu",
        "title": "選單",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.refresh",
        "title": "重新整理狀態",
        "category": "Codex SDLC",
        "icon": "$(refresh)"
      },
      {
        "command": "codexSdlc.doctor",
        "title": "doctor —— 完整健檢",
        "category": "Codex SDLC",
        "icon": "$(checklist)"
      },
      {
        "command": "codexSdlc.apply",
        "title": "apply —— 把 sdlc.config.json 套到 agent 定義",
        "category": "Codex SDLC",
        "icon": "$(check-all)"
      },
      {
        "command": "codexSdlc.openSettings",
        "title": "開啟設定面板",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.editSetting",
        "title": "修改",
        "category": "Codex SDLC",
        "icon": "$(edit)"
      },
      {
        "command": "codexSdlc.applyPreset",
        "title": "換成預設組合（fast／balanced／deep）",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.applyProposalFor",
        "title": "採用 tune 對這個 agent 的建議",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.install",
        "title": "安裝到這個工作區",
        "category": "Codex SDLC",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codexSdlc.installFrom",
        "title": "選擇發佈物安裝…",
        "category": "Codex SDLC",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codexSdlc.repair",
        "title": "補回工具檔（update）",
        "category": "Codex SDLC",
        "icon": "$(tools)"
      },
      {
        "command": "codexSdlc.mergeAgents",
        "title": "比對並合併 AGENTS.md.new",
        "category": "Codex SDLC",
        "icon": "$(git-merge)"
      },
      {
        "command": "codexSdlc.toggleGate",
        "title": "打開／關閉規範的機械層",
        "category": "Codex SDLC",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "codexSdlc.pickPwsh",
        "title": "選擇 PowerShell 7（pwsh）的位置",
        "category": "Codex SDLC",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codexSdlc.openFile",
        "title": "開啟檔案",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.openWalkthrough",
        "title": "開始使用（四步引導）",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.tune",
        "title": "tune —— 依 repo 現況給調校建議",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.whatsnew",
        "title": "whatsnew —— 變更說明",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.checkUpdate",
        "title": "立即檢查更新",
        "category": "Codex SDLC"
      },
      {
        "command": "codexSdlc.showOutput",
        "title": "顯示輸出",
        "category": "Codex SDLC"
      }
    ],
    "configuration": {
      "title": "Codex SDLC",
      "properties": {
        "codexSdlc.pwshPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "PowerShell 7（`pwsh`）的完整路徑。留空 = 先找 PATH，再找常見的安裝位置。**只放這台機器的東西** —— 工作流本身的設定（model／effort、更新檢查）一律在專案根的 `sdlc.config.json`，不在這裡。"
        },
        "codexSdlc.releaseSource": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "發佈物的 GitHub repo 網址（例如 `https://github.com/你的組織/codex-sdlc`）。**安裝／補工具檔時先問它有沒有新版**，拿不到才用這個 extension 內附的那一份。留空 = 讀內附發佈物版本檔裡的 `source`。這是「這台機器去哪裡拿發佈物」，不是工作流設定 —— 專案自己的更新來源仍然是 `sdlc.config.json` 的 `update.source`。"
        },
        "codexSdlc.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "在狀態列顯示工作流版本、調校漂移、hooks 信任狀態與新版提示。"
        },
        "codexSdlc.problems.enabled": {
          "type": "boolean",
          "default": true,
          "description": "存檔時跑 guideline-gate 與 dlp-gate，把命中放進 Problems 面板。"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node scripts/run-node-tests.js",
    "test:host": "node scripts/run-host-test.js",
    "package": "vsce package --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  }
}
